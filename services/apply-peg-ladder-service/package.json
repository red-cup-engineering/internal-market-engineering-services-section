{
  "name": "@red-cup-engineering/apply-peg-ladder-service",
  "version": "0.1.1",
  "description": "Signs and broadcasts a peg-ladder diff's limit_order_create/limit_order_cancel operations through the revived Hive client, under an armed mandate record naming the account, both operations, and a maximum exposure; refuses mandate-not-armed and writes the diff as a dry-run record otherwise. Every broadcast is journaled with its transaction id.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/internal-market-engineering-services-section.git",
    "directory": "services/apply-peg-ladder-service"
  },
  "type": "module",
  "private": false,
  "license": "MIT",
  "exports": {
    ".": "./src/apply-peg-ladder.mjs",
    "./scripts/apply-peg-ladder.mjs": "./scripts/apply-peg-ladder.mjs"
  },
  "bin": {
    "apply-peg-ladder": "scripts/apply-peg-ladder.mjs"
  },
  "files": [
    "src",
    "scripts",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@red-cup-engineering/exact-number-data-service": "^0.2.3",
    "@red-cup-engineering/metrologic": "workspace:*",
    "@red-cup-engineering/semiotic-eavt-engineering-services-section": "^0.6.0",
    "@red-cup-engineering/computer-data-engineering-services-section": "workspace:*",
    "@red-cup-engineering/eavt-engineering-services-section": "^0.14.2",
    "@red-cup-engineering/computer-file-engineering-services-section": "workspace:*",
    "@red-cup-engineering/hive-blockchain-client-service": "workspace:*",
    "@red-cup-engineering/hive-fleet-operations-service": "workspace:*",
    "@red-cup-engineering/witness-journal-document-service": "workspace:*"
  },
  "devDependencies": {},
  "scripts": {
    "check": "node --check src/apply-peg-ladder.mjs && node --check scripts/apply-peg-ladder.mjs",
    "test": "node --test test/*.test.mjs",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=24.2.0"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/561-group/.github/blob/main/TIPS.md"
  }
}
